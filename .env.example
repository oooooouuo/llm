# Copy to .env and fill your own credentials. No API calls occur during input checks.
OPENAI_API_KEY=
TOGETHER_API_KEY=
SILICONFLOW_API_KEY=
WSD_GPT4O_BASE_URL=https://api.openai.com/v1
WSD_GPT4O_MODEL_ID=gpt-4o
WSD_LLAMA_BASE_URL=https://api.together.xyz/v1
WSD_LLAMA_MODEL_ID=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
